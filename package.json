{
  "name": "discordia-clients",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web-app",
    "build": "npm run build --workspace=web-app",
    "lint": "npm run lint --workspace=web-app",
    "dev:mobile": "npm run start --workspace=mobile-app",
    "android": "npm run android --workspace=mobile-app"
  },
  "dependencies": {
    "expo-linear-gradient": "~57.0.2"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
