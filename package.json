{
  "name": "discordia-clients",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web-app",
    "dev:backoffice": "npm run dev --workspace=backoffice",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test --workspaces --if-present -- --coverage",
    "dev:mobile": "npm run start --workspace=mobile-app",
    "android": "npm run android --workspace=mobile-app"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}