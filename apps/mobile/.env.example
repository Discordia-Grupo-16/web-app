# Backend API Gateway
# En emulador de Android Studio: 10.0.2.2
# En dispositivo físico con Expo Go: la IP local de tu PC (ej. 192.168.0.22)
EXPO_PUBLIC_API_HOST=10.0.2.2
EXPO_PUBLIC_API_PORT=8000
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
EXPO_PUBLIC_API_TIMEOUT_MS=10000

# WebSocket endpoint of the gateway (chat). Without the token: the client appends it.
# En emulador de Android Studio: 10.0.2.2 · En dispositivo físico: la IP local de tu PC
EXPO_PUBLIC_WS_URL=ws://10.0.2.2:8000/api/v1/ws

# Web app base URL (Vite dev server), used to build the invite links people share.
# Same host rule as the API: 10.0.2.2 on the Android emulator, your PC's local IP on a physical device
EXPO_PUBLIC_WEB_URL=http://10.0.2.2:5173

# Google sign-in (OAuth client ID of type "Android": package com.discordia.mobile + SHA-1 of the EAS keystore).
# Public. Empty: the "Continuar con Google" button is hidden. It must also be in GOOGLE_CLIENT_IDS of identity.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
