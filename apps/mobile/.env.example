# Backend API Gateway
# En emulador de Android Studio: 10.0.2.2
# En dispositivo físico con Expo Go: la IP local de tu PC (ej. 192.168.0.22)
EXPO_PUBLIC_API_HOST=10.0.2.2
EXPO_PUBLIC_API_PORT=8000
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
EXPO_PUBLIC_API_TIMEOUT_MS=10000

# WebSocket endpoint of the gateway (chat). Without the token: the client appends it.
# En emulador de Android Studio: 10.0.2.2 · En dispositivo físico: la IP local de tu PC
EXPO_PUBLIC_WS_URL=ws://10.0.2.2:8000/api/v1/ws
