{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://GATEWAY_DE_LA_NUBE/api/v1",
        "EXPO_PUBLIC_WS_URL": "wss://GATEWAY_DE_LA_NUBE/api/v1/ws"
      }
    }
  }
}
